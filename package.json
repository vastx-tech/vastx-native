{
  "name": "vastx-native",
  "version": "3.0.0",
  "description": "Build real native Android and iOS apps with Nuxt and Vue: file-based pages, auto-imports and native views, no WebView. Powered by NativeScript.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "nativescript",
    "native",
    "mobile",
    "android",
    "ios",
    "cross-platform"
  ],
  "homepage": "https://native.vastx.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vastx-tech/vastx-native.git"
  },
  "bugs": "https://github.com/vastx-tech/vastx-native/issues",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": "./dist/runtime/*",
    "./cli/*": "./cli/*"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "bin": {
    "vastx-native": "bin/vastx-native.mjs"
  },
  "files": [
    "dist",
    "bin",
    "cli",
    "!cli/tests",
    "STYLING.md",
    "CHANGELOG.md",
    "mcp-server/bin",
    "mcp-server/src",
    "mcp-server/README.md"
  ],
  "scripts": {
    "release:build": "node --max-old-space-size=4096 ./node_modules/@nuxt/module-builder/dist/cli.mjs build",
    "prepublishOnly": "npm run release:build",
    "release": "node scripts/release.mjs",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "native:init": "node ./bin/vastx-native.mjs init",
    "native:dev:ios": "node ./bin/vastx-native.mjs dev ios",
    "native:dev:android": "node ./bin/vastx-native.mjs dev android",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test cli/tests/release.test.mjs cli/tests/icons.test.mjs cli/tests/android-theme.test.mjs cli/tests/auto-import-loader.test.mjs cli/tests/styling.test.mjs cli/tests/ios-infoplist-fix.test.mjs cli/tests/lighter.test.mjs cli/tests/splash.test.mjs mcp-server/packaged-cli.test.mjs",
    "test:mcp": "node --test mcp-server/packaged-cli.test.mjs",
    "test:styling": "node --test cli/tests/styling.test.mjs",
    "test:ios-infoplist": "node --test cli/tests/ios-infoplist-fix.test.mjs"
  },
  "dependencies": {
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@nativescript/tailwind": "4.0.10",
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "postcss-value-parser": "4.2.0"
  },
  "peerDependencies": {
    "@nativescript/core": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "nativescript-vue": "^3.0.0",
    "nuxt": "^4.0.0",
    "zod": "^3.25.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nativescript/camera": "^7.0.0",
    "@nativescript/core": "^9.1.2",
    "@nativescript/geolocation": "^9.0.0",
    "@nativescript/types": "^9.1.1",
    "@nativescript/webpack": "~5.0.38",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nuxt/eslint-config": "^1.0.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "nativescript": "^9.1.1",
    "nativescript-vue": "^3.1.2",
    "nuxt": "^4.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0",
    "zod": "^3.25.0"
  }
}
