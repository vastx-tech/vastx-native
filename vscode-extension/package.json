{
  "name": "vastx-native-vscode",
  "displayName": "VastX Native",
  "description": "Run, hot-reload, and manage VastX Native projects from VS Code — device picker, hot restart, and every vastx-native CLI command from the Command Palette.",
  "version": "0.1.0",
  "publisher": "vastx-tech",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vastx-tech/vastx-native"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:nativescript.config.ts"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vastxNative.create",
        "title": "VastX Native: Create Project..."
      },
      {
        "command": "vastxNative.init",
        "title": "VastX Native: Init (add to existing project)"
      },
      {
        "command": "vastxNative.run",
        "title": "VastX Native: Run..."
      },
      {
        "command": "vastxNative.hotRestart",
        "title": "VastX Native: Hot Restart"
      },
      {
        "command": "vastxNative.forceRestart",
        "title": "VastX Native: Force Restart (rebuild native)"
      },
      {
        "command": "vastxNative.toggleWatcher",
        "title": "VastX Native: Toggle File Watcher"
      },
      {
        "command": "vastxNative.stop",
        "title": "VastX Native: Stop"
      },
      {
        "command": "vastxNative.build",
        "title": "VastX Native: Build..."
      },
      {
        "command": "vastxNative.doctor",
        "title": "VastX Native: Doctor"
      },
      {
        "command": "vastxNative.analyze",
        "title": "VastX Native: Analyze Bundle Size..."
      },
      {
        "command": "vastxNative.lint",
        "title": "VastX Native: Lint Routes"
      },
      {
        "command": "vastxNative.clean",
        "title": "VastX Native: Clean"
      },
      {
        "command": "vastxNative.keystoreCreate",
        "title": "VastX Native: Create Signing Keystore..."
      },
      {
        "command": "vastxNative.selectDevice",
        "title": "VastX Native: Select Device..."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.6.0"
  }
}
